# ==========================================
# Expo / React Native App .gitignore
# ==========================================

# Dependencies
node_modules/

# Expo Cache & Web Builds
.expo/
dist/
web-build/

# Native Build Caches & Outputs
.gradle/
android/.gradle/
android/build/
android/app/build/

# Binaries & Secrets
*.apk
*.aab
*.ipa
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
google-services.json
GoogleService-Info.plist

# Logs & OS Cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
