{
  "expo": {
    "name": "HostelSaathi Student",
    "slug": "hostelsaathi-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hostelsaathi.student",
      "infoPlist": {
        "NSCameraUsageDescription": "HostelSaathi requires camera access to capture evidence photos when raising a hostel complaint.",
        "NSPhotoLibraryUsageDescription": "HostelSaathi requires photo library access to upload proof photos for your hostel complaint."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090d16"
      },
      "package": "com.hostelsaathi.student",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HostelSaathi to access your camera to take complaint evidence pictures."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HostelSaathi to access your photos to attach complaint proof images."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#090d16"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b3821fee-59a6-45cf-ad83-d45b8460c526"
      }
    }
  }
}
